---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, tagSlug } from '../../lib/posts';
import { SITE, formatDate } from '../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={post.data.title} description={post.data.description} type="article">
  <article>
    <header class="article-head">
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <div class="meta">
        <span>{SITE.author}</span>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {post.data.updated && <span>수정 {formatDate(post.data.updated)}</span>}
        {post.data.tags.map((tag) => <a class="tag" href={`/tags/${tagSlug(tag)}/`}>{tag}</a>)}
      </div>
    </header>
    {toc.length > 2 && (
      <nav class="toc" aria-label="목차">
        <p>목차</p>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
