---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';
import { SITE } from '../site';

const posts = await getPosts();
---
<Base>
  <section class="intro">
    <h1>{SITE.title}</h1>
    <p>{SITE.description}</p>
  </section>
  <PostList posts={posts} />
</Base>
