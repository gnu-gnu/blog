---
import Base from '../../layouts/Base.astro';
import { getCategories } from '../../lib/posts';

const categories = await getCategories();
---
<Base title="분류">
  <section class="intro">
    <h1>분류</h1>
  </section>
  <ul class="cat-list">
    {categories.map((c) => (
      <li>
        <a class="title" href={`/categories/${c.slug}/`}>{c.name}</a>
        <span class="count">{c.posts.length}</span>
        <p>{c.description}</p>
      </li>
    ))}
  </ul>
</Base>
